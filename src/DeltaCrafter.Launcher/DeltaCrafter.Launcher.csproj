<Project Sdk="Microsoft.NET.Sdk">
  <!-- 自安装启动器:发布为单个 DeltaCrafter.exe,内嵌完整客户端(payload.zip)。
       首次运行或版本变化时解压到 %LocalAppData%\DeltaCrafter\app\<PayloadId>,之后直接启动。
       只由 scripts\build-release.ps1 发布(需传 PayloadZip/PayloadId),不进解决方案构建。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DeltaCrafter.Launcher</RootNamespace>
    <AssemblyName>DeltaCrafter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\DeltaCrafter.App\Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 纯托管启动器:单文件内的托管程序集直接从 exe 映射加载,不会再解压到 temp。 -->
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(PayloadZip)' != ''">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PayloadId" Value="$(PayloadId)" />
  </ItemGroup>
</Project>
