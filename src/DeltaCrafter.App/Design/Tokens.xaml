<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 品牌色(战术绿,与 AppIcon 一致) ============ -->
    <!-- 覆写强调色画刷:原生控件(主按钮/开关/进度条/选中指示)统一换成品牌色。
         只覆写画刷,不在本字典定义 SystemAccentColor* 颜色:WinAppSDK 1.7 的 XamlCompiler
         遇到这些 Color 元素会无提示地以退出码 1 崩溃(CI 二分确认)。
         浅色主题用深绿保证白字对比度 ≥4.5。 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8FE36B" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8FE36B" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8FE36B" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#A6EC88" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#A6EC88" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8FE36B" />
            <!-- 应用自有:面板描边上的品牌色细边、分区标签、页面底色 -->
            <SolidColorBrush x:Key="DeltaAccentBrush" Color="#8FE36B" />
            <SolidColorBrush x:Key="DeltaAccentSubtleBrush" Color="#8FE36B" Opacity="0.12" />
            <SolidColorBrush x:Key="DeltaPanelBrush" Color="#1A2026" Opacity="0.72" />
            <SolidColorBrush x:Key="DeltaPanelStrokeBrush" Color="#FFFFFF" Opacity="0.08" />
            <SolidColorBrush x:Key="DeltaChromeBrush" Color="#0E1215" Opacity="0.55" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2F7A1F" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2F7A1F" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2F7A1F" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#256318" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#256318" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#2F7A1F" />
            <SolidColorBrush x:Key="DeltaAccentBrush" Color="#2F7A1F" />
            <SolidColorBrush x:Key="DeltaAccentSubtleBrush" Color="#2F7A1F" Opacity="0.10" />
            <SolidColorBrush x:Key="DeltaPanelBrush" Color="#FFFFFF" Opacity="0.78" />
            <SolidColorBrush x:Key="DeltaPanelStrokeBrush" Color="#000000" Opacity="0.08" />
            <SolidColorBrush x:Key="DeltaChromeBrush" Color="#FFFFFF" Opacity="0.45" />
        </ResourceDictionary>
        <!-- 高对比度主题不覆写任何颜色,完全交给系统。 -->
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>

    <!-- ============ 圆角令牌(全局唯一定义;页面/控件禁止写死圆角) ============ -->
    <!-- 战术风格:小圆角,硬朗但不刺眼。覆写系统键让原生控件(按钮/输入框/弹窗/菜单)一致。 -->
    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
    <!-- 应用自有层级 -->
    <CornerRadius x:Key="TokenCornerCard">4</CornerRadius>
    <CornerRadius x:Key="TokenCornerBadge">2</CornerRadius>

    <!-- ============ 间距令牌 ============ -->
    <Thickness x:Key="TokenPagePadding">32,20,32,32</Thickness>
    <Thickness x:Key="TokenCardPadding">20,16,20,16</Thickness>
    <x:Double x:Key="TokenGapXS">4</x:Double>
    <x:Double x:Key="TokenGapS">8</x:Double>
    <x:Double x:Key="TokenGapM">12</x:Double>
    <x:Double x:Key="TokenGapL">20</x:Double>
    <x:Double x:Key="TokenGapXL">28</x:Double>

    <!-- ============ 尺寸令牌 ============ -->
    <x:Double x:Key="TokenContentMaxWidth">1080</x:Double>
    <x:Double x:Key="TokenWideMaxWidth">1440</x:Double>
    <x:Double x:Key="TokenSidePanelWidth">320</x:Double>
    <x:Double x:Key="TokenFacilityCardHeight">212</x:Double>

</ResourceDictionary>
