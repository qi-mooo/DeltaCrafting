<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 圆角令牌(全局唯一定义;页面/控件禁止写死圆角) ============ -->
    <!-- 覆写系统键:所有原生控件(按钮/输入框/弹窗/菜单)统一走这两个值,全程无尖角。 -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    <!-- 应用自有层级 -->
    <CornerRadius x:Key="TokenCornerCard">8</CornerRadius>
    <CornerRadius x:Key="TokenCornerBadge">12</CornerRadius>

    <!-- ============ 间距令牌 ============ -->
    <Thickness x:Key="TokenPagePadding">28,16,28,24</Thickness>
    <Thickness x:Key="TokenCardPadding">16,12,16,12</Thickness>
    <x:Double x:Key="TokenGapXS">4</x:Double>
    <x:Double x:Key="TokenGapS">8</x:Double>
    <x:Double x:Key="TokenGapM">12</x:Double>
    <x:Double x:Key="TokenGapL">16</x:Double>
    <x:Double x:Key="TokenGapXL">28</x:Double>

    <!-- ============ 尺寸令牌 ============ -->
    <x:Double x:Key="TokenContentMaxWidth">1200</x:Double>
    <x:Double x:Key="TokenOverviewMaxWidth">1600</x:Double>
    <x:Double x:Key="TokenFacilityCardHeight">168</x:Double>

</ResourceDictionary>
