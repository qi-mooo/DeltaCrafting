<Page
    x:Class="DeltaCrafter.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeltaCrafter.App.Controls">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- 星号三列确定性居中(同 PlanPage 注释):不依赖 Stretch+MaxWidth 的对齐退化。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="999*" MaxWidth="{StaticResource TokenContentMaxWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Padding="{StaticResource TokenPagePadding}"
                        Spacing="{StaticResource TokenGapM}">

                <controls:PageHeader Title="设置" />

                <!-- 游戏 -->
                <TextBlock Text="游戏" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,8,0,0" />
                <controls:SettingCard Glyph="&#xE7FC;" Header="启动方式"
                                      Description="Steam 模式仅接管本机已安装的游戏,不支持远程串流。">
                    <controls:SettingCard.Slot>
                        <ComboBox SelectedIndex="{x:Bind Vm.LaunchModeIndex, Mode=TwoWay}" MinWidth="180">
                            <ComboBoxItem Content="游戏启动器 / 可执行文件" />
                            <ComboBoxItem Content="Steam (本机游戏)" />
                        </ComboBox>
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <controls:SettingCard Glyph="&#xE7FC;" Header="游戏路径"
                                      Visibility="{x:Bind Vm.LauncherSettingsVisibility, Mode=OneWay}"
                                      Description="{x:Bind Vm.GamePath, Mode=OneWay}">
                    <controls:SettingCard.Slot>
                        <Button Content="浏览…" Command="{x:Bind Vm.BrowseGamePathCommand}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <controls:SettingCard Glyph="&#xE7FC;" Header="Steam 客户端"
                                      Visibility="{x:Bind Vm.SteamSettingsVisibility, Mode=OneWay}"
                                      Description="{x:Bind Vm.SteamPathDescription, Mode=OneWay}">
                    <controls:SettingCard.Slot>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="选择 steam.exe…" Command="{x:Bind Vm.BrowseSteamPathCommand}" />
                            <Button Content="自动检测" Command="{x:Bind Vm.ResetSteamPathCommand}" />
                        </StackPanel>
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <controls:SettingCard Glyph="&#xE943;" Header="Steam App ID"
                                      Visibility="{x:Bind Vm.SteamSettingsVisibility, Mode=OneWay}"
                                      Description="默认 2507950。不同发行版本请填写 Steam 商店网址 /app/ 后的数字,并将游戏语言设为简体中文。">
                    <controls:SettingCard.Slot>
                        <TextBox Width="160" Text="{x:Bind Vm.SteamAppId, Mode=TwoWay}"
                                 InputScope="Number" AutomationProperties.Name="Steam App ID" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <controls:SettingCard Glyph="&#xE7B3;" Header="游戏窗口"
                                      Description="{x:Bind Vm.WindowRuleText, Mode=OneWay}">
                    <controls:SettingCard.Slot>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="定位窗口…" Click="OnPickWindow" />
                            <Button Content="重置" Command="{x:Bind Vm.ResetWindowRuleCommand}" />
                        </StackPanel>
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <controls:SettingCard Glyph="&#xE916;" Header="启动超时(秒)"
                                      Description="启动后等待游戏窗口出现的上限。">
                    <controls:SettingCard.Slot>
                        <NumberBox Width="140" SpinButtonPlacementMode="Inline"
                                   Minimum="30" Maximum="900" SmallChange="10"
                                   Value="{x:Bind Vm.LaunchTimeoutSeconds, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <controls:SettingCard Glyph="&#xE916;" Header="进入大厅超时(秒)"
                                      Description="窗口出现后等待登录、加载与公告弹窗完成的上限。">
                    <controls:SettingCard.Slot>
                        <NumberBox Width="140" SpinButtonPlacementMode="Inline"
                                   Minimum="30" Maximum="900" SmallChange="10"
                                   Value="{x:Bind Vm.LobbyTimeoutSeconds, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <TextBlock Text="Steam 游戏状态" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,12,0,0" />
                <controls:SettingCard Glyph="&#xE7FC;" Header="游戏中暂停任务"
                                      Description="游戏中或查询失败时等待 5 分钟再检查。">
                    <controls:SettingCard.Slot>
                        <ToggleSwitch IsOn="{x:Bind Vm.SteamActivityEnabled, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE77B;" Header="Steam ID">
                    <controls:SettingCard.Slot>
                        <TextBox Width="220" MaxLength="17" InputScope="Number"
                                 Text="{x:Bind Vm.SteamActivityId, Mode=TwoWay}"
                                 AutomationProperties.Name="Steam ID" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE72E;" Header="Steam API key">
                    <controls:SettingCard.Slot>
                        <PasswordBox Width="280" MaxLength="32"
                                     Password="{x:Bind Vm.SteamActivityApiKey, Mode=TwoWay}"
                                     AutomationProperties.Name="Steam API key" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE968;" Header="当前状态"
                                      Description="{x:Bind Vm.SteamActivityStatus, Mode=OneWay}">
                    <controls:SettingCard.Slot>
                        <Button Command="{x:Bind Vm.CheckSteamActivityCommand}"
                                ToolTipService.ToolTip="检查 Steam 状态" AutomationProperties.Name="检查 Steam 状态">
                            <FontIcon Glyph="&#xE72C;" />
                        </Button>
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <!-- 运行 -->
                <TextBlock Text="运行" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,12,0,0" />
                <controls:SettingCard Glyph="&#xE7E8;" Header="收取后行为"
                                      Description="每轮收取并续造完成后如何处置游戏:关闭省资源;最小化后台挂机;或回到大厅留在前台。">
                    <controls:SettingCard.Slot>
                        <ComboBox SelectedIndex="{x:Bind Vm.AfterRunIndex, Mode=TwoWay}" MinWidth="180">
                            <ComboBoxItem Content="收完即关闭" />
                            <ComboBoxItem Content="保持运行(最小化)" />
                            <ComboBoxItem Content="保持运行(留在大厅)" />
                        </ComboBox>
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <controls:SettingCard Glyph="&#xE945;" Header="失败重试间隔(分钟)"
                                      Description="某一轮失败后,间隔多久才会再次自动尝试。">
                    <controls:SettingCard.Slot>
                        <NumberBox Width="140" SpinButtonPlacementMode="Inline"
                                   Minimum="1" Maximum="720" SmallChange="5"
                                   Value="{x:Bind Vm.FailureRetryMinutes, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <controls:SettingCard Glyph="&#xEC32;" Header="等待期间阻止睡眠"
                                      Description="仅阻止系统进入睡眠,不改变熄屏。电脑需保持通电唤醒。">
                    <controls:SettingCard.Slot>
                        <ToggleSwitch IsOn="{x:Bind Vm.PreventSleep, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <!-- 应用 -->
                <TextBlock Text="应用" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,12,0,0" />
                <controls:SettingCard Glyph="&#xE7B5;" Header="开机自启"
                                      Description="以计划任务在登录时静默启动(最高权限,不弹 UAC)。">
                    <controls:SettingCard.Slot>
                        <ToggleSwitch IsOn="{x:Bind Vm.AutostartEnabled, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <InfoBar IsOpen="{x:Bind Vm.HasAutostartError, Mode=OneWay}"
                         Severity="Error" IsClosable="False"
                         Title="开机自启设置失败"
                         Message="{x:Bind Vm.AutostartError, Mode=OneWay}" />

                <controls:SettingCard Glyph="&#xE756;" Header="关闭按钮行为"
                                      Description="开启后点关闭最小化到托盘,后台继续按计划运行。">
                    <controls:SettingCard.Slot>
                        <ToggleSwitch IsOn="{x:Bind Vm.CloseToTray, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <controls:SettingCard Glyph="&#xE771;" Header="主题"
                                      Description="深色 / 浅色 / 跟随系统。">
                    <controls:SettingCard.Slot>
                        <ComboBox SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}" MinWidth="150">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <TextBlock Text="T-Display-S3" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,12,0,0" />
                <controls:SettingCard Glyph="&#xE968;" Header="局域网设备 API"
                                      Description="{x:Bind Vm.DeviceApiStatus, Mode=OneWay}">
                    <controls:SettingCard.Slot>
                        <ToggleSwitch IsOn="{x:Bind Vm.DeviceApiEnabled, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE839;" Header="监听端口"
                                      Description="与 S3 连接同一局域网,在防火墙中允许此端口。">
                    <controls:SettingCard.Slot>
                        <NumberBox Width="140" SpinButtonPlacementMode="Inline"
                                   Minimum="1024" Maximum="65535" SmallChange="1"
                                   Value="{x:Bind Vm.DeviceApiPort, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE72E;" Header="配对密钥"
                                      Description="复制到固件配置。重新生成后,旧密钥立即失效。">
                    <controls:SettingCard.Slot>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind Vm.CopyDeviceApiKeyCommand}"
                                    ToolTipService.ToolTip="复制配对密钥" AutomationProperties.Name="复制配对密钥">
                                <FontIcon Glyph="&#xE8C8;" />
                            </Button>
                            <Button Command="{x:Bind Vm.GenerateDeviceApiKeyCommand}"
                                    ToolTipService.ToolTip="重新生成密钥" AutomationProperties.Name="重新生成密钥">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>
                    </controls:SettingCard.Slot>
                </controls:SettingCard>
                <controls:SettingCard Glyph="&#xE7F4;" Header="允许设备控制"
                                      Description="允许设备执行任务,以及保存设施和全局设置。">
                    <controls:SettingCard.Slot>
                        <ToggleSwitch IsOn="{x:Bind Vm.DeviceApiAllowControl, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

                <!-- 关于 -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
                    <StackPanel Spacing="6">
                        <!-- 标题/版本在左,检查更新按钮在最右;更新过程与结论走下方 InfoBar。 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="关于" Style="{StaticResource CardTitleTextStyle}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                    <Run Text="三角洲特勤助手" />
                                    <Run Text="{x:Bind Vm.VersionText}" />
                                </TextBlock>
                                <TextBlock Text="通过画面识别与模拟操作自动收取并续造特勤处物资。请在游戏设置中使用 16:9 无边框窗口,并以管理员身份运行本程序。"
                                           Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Command="{x:Bind Vm.CheckUpdateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="16" Height="16"
                                                  IsActive="{x:Bind Vm.IsCheckingUpdate, Mode=OneWay}"
                                                  Visibility="{x:Bind Vm.CheckingRingVisibility, Mode=OneWay}" />
                                    <TextBlock Text="检查更新" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <InfoBar IsOpen="{x:Bind Vm.HasUpdateStatus, Mode=OneWay}"
                                 Severity="{x:Bind Vm.UpdateSeverity, Mode=OneWay}" IsClosable="False"
                                 Message="{x:Bind Vm.UpdateStatus, Mode=OneWay}" />
                        <HyperlinkButton Content="打开数据与配置文件夹"
                                         Command="{x:Bind Vm.OpenDataFolderCommand}"
                                         Padding="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 开发者 -->
                <controls:SettingCard Glyph="&#xEC7A;" Header="开发者模式"
                                      Description="显示总览页的「单步调试」工具(分段执行、画面诊断、扫描配方目录)。">
                    <controls:SettingCard.Slot>
                        <ToggleSwitch IsOn="{x:Bind Vm.DeveloperMode, Mode=TwoWay}" />
                    </controls:SettingCard.Slot>
                </controls:SettingCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
