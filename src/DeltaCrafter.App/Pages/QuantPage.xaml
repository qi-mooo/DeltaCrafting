<Page x:Class="DeltaCrafter.App.Pages.QuantPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="子弹量化" FontSize="26" VerticalAlignment="Center"/>
            <TextBlock x:Name="DataTime" Grid.Column="1" TextWrapping="Wrap" MaxWidth="300" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="16" Padding="0,8,0,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4"><TextBlock Text="持仓成本" TextWrapping="Wrap"/><TextBlock x:Name="OpenCost" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="今日已实现收益" TextWrapping="Wrap"/><TextBlock x:Name="TodayProfit" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="累计已实现收益" TextWrapping="Wrap"/><TextBlock x:Name="TotalProfit" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="3" Spacing="4"><TextBlock Text="胜率 / 最大回撤"/><TextBlock x:Name="TradeStats" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
        </Grid>
        <Pivot x:Name="Views" Grid.Row="2" SelectionChanged="ChangeView">
            <PivotItem Header="低价预测"/><PivotItem Header="自选计划"/><PivotItem Header="持仓"/><PivotItem Header="成交记录"/><PivotItem Header="策略选品"/>
        </Pivot>
        <Grid Grid.Row="3" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,0,0,6">
                    <ComboBox x:Name="GradeFilter" Header="等级" Width="100" SelectedIndex="4" SelectionChanged="FilterChanged">
                        <x:String>0级</x:String><x:String>1级</x:String><x:String>2级</x:String><x:String>3级</x:String>
                        <x:String>4级</x:String><x:String>5级</x:String><x:String>6级</x:String>
                    </ComboBox>
                    <ComboBox x:Name="HourFilter" Header="时段（北京时间）" Width="150" SelectionChanged="FilterChanged"/>
                    <TextBox x:Name="Search" Header="物品名称" Width="180" TextChanged="SearchChanged"/>
                    <ComboBox x:Name="SortFilter" Header="排序" Width="136" SelectedIndex="0" SelectionChanged="FilterChanged">
                        <x:String>时段优先</x:String><x:String>价格从低到高</x:String><x:String>物品名称</x:String>
                        <x:String>每种最低价</x:String>
                    </ComboBox>
                    <NumberBox x:Name="Budget" Header="预算" Width="150" Minimum="1" Maximum="1000000000" ValueChanged="PreferenceChanged"/>
                    <ComboBox x:Name="StrategyFilter" Header="策略" Width="136" SelectionChanged="StrategyChanged" Visibility="Collapsed"/>
                    <Button x:Name="BatchButton" Content="刷新行情" Click="RefreshBatch" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                    <Button x:Name="CancelQueryButton" Click="CancelRefresh" VerticalAlignment="Bottom" Width="40" Height="32" Visibility="Collapsed"
                            ToolTipService.ToolTip="取消查询" AutomationProperties.Name="取消查询"><FontIcon Glyph="&#xE711;" FontSize="16"/></Button>
                    <Button Click="EditOptions" VerticalAlignment="Bottom" Width="40" Height="32" ToolTipService.ToolTip="量化参数" AutomationProperties.Name="量化参数"><FontIcon Glyph="&#xE713;" FontSize="18"/></Button>
                    <Button x:Name="RefreshButton" Click="RefreshForecast" VerticalAlignment="Bottom" Width="40" Height="32"
                            ToolTipService.ToolTip="刷新所选等级的低价预测" AutomationProperties.Name="刷新低价预测">
                        <FontIcon Glyph="&#xE72C;" FontSize="18"/>
                    </Button>
                    <ProgressRing x:Name="QueryProgress" Width="24" Height="24" IsActive="False" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ListHeading" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="EmptyRows" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <ListView x:Name="Rows" Grid.Row="1" SelectionMode="Single" SelectionChanged="SelectRow" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid Padding="4,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                    <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Extra}" HorizontalAlignment="Right" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ScrollViewer x:Name="DetailPanel" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,0,6,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ItemTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Click="CloseDetail" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="关闭详情" AutomationProperties.Name="关闭详情"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
                        </Grid>
                        <Image x:Name="ItemImage" Height="76" Width="120" Stretch="Uniform" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ItemInfo" TextWrapping="Wrap"/>
                        <Button x:Name="HistoryButton" Content="查询历史与指标" Click="RefreshHistory" HorizontalAlignment="Stretch"/>
                        <Button x:Name="BacktestButton" Content="运行历史回测" Click="RunBacktest" HorizontalAlignment="Stretch" IsEnabled="False"/>
                        <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Spacing="6">
                            <TextBlock x:Name="HistoryTime" FontSize="12" TextWrapping="Wrap"/>
                            <Canvas x:Name="HistoryChart" Height="80" SizeChanged="ChartSizeChanged" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Polyline x:Name="PriceLine" Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2"/>
                            </Canvas>
                            <TextBlock x:Name="Indicators" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <NumberBox x:Name="BuyPrice" Header="买入限价 / 实际买入价" Minimum="1" Maximum="1000000000" ValueChanged="Calculate"/>
                        <NumberBox x:Name="SellPrice" Header="卖出目标 / 实际卖出价" Minimum="1" Maximum="1000000000" ValueChanged="Calculate"/>
                        <NumberBox x:Name="Quantity" Header="数量（发）" Minimum="1" Maximum="1000000" SpinButtonPlacementMode="Compact" SmallChange="1" ValueChanged="Calculate"/>
                        <NumberBox x:Name="Fee" Header="卖出综合手续费（%）" Minimum="0" Maximum="99.99" ValueChanged="Calculate"/>
                        <TextBlock x:Name="Estimate" TextWrapping="Wrap"/>
                        <Button x:Name="SaveWatchButton" Content="保存自选计划" Click="SaveWatch" HorizontalAlignment="Stretch"/>
                        <Button x:Name="PurchaseButton" Content="记录实际买入" Click="RecordPurchase" HorizontalAlignment="Stretch"/>
                        <Button x:Name="SaleButton" Content="记录实际卖出" Click="RecordSale" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                        <Button x:Name="RemoveWatchButton" Content="移除自选" Click="RemoveWatch" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="4" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
</Page>
