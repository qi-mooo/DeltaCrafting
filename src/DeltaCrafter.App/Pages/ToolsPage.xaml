<Page x:Class="DeltaCrafter.App.Pages.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:DeltaCrafter.App.Controls">
    <!-- 星号三列确定性居中(同 PlanPage 注释)。各屏切换与元素命名由 ToolsPage.xaml.cs 驱动,
         这里只负责外观:菜单为磁贴网格,列表/详情放在同一块面板内。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="999*" MaxWidth="{StaticResource TokenContentMaxWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
    <Grid Grid.Column="1" Padding="{StaticResource TokenPagePadding}" RowSpacing="{StaticResource TokenGapL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题:动态标题 + 页码 -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ToolTitle" Text="工具"
                       Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="PageNumber" Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource NumericTextStyle}" FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- 工具入口 -->
        <Grid x:Name="ToolMenu" Grid.Row="1" ColumnSpacing="16" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Tag="password" Click="OpenTool" Style="{StaticResource TileButtonStyle}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE72E;" FontSize="26" HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="今日密码" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="各地图密码门今日密码" Style="{StaticResource SecondaryTextStyle}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Tag="market" Click="OpenTool" Style="{StaticResource TileButtonStyle}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE7BF;" FontSize="26" HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="当前集市物品" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="本期集市在售物品与价格" Style="{StaticResource SecondaryTextStyle}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Tag="gun" Click="OpenTool" Style="{StaticResource TileButtonStyle}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE90F;" FontSize="26" HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="改枪码" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="热门方案或按枪械查询,一键复制" Style="{StaticResource SecondaryTextStyle}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 改枪码:模式 -->
        <Grid x:Name="ModeMenu" Grid.Row="1" ColumnSpacing="16" VerticalAlignment="Top" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Tag="gun" Click="ChooseMode" Style="{StaticResource TileButtonStyle}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE7C1;" FontSize="26" HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="烽火地带" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Tag="operator" Click="ChooseMode" Style="{StaticResource TileButtonStyle}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE909;" FontSize="26" HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="大战场" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 改枪码:查询方式 -->
        <Grid x:Name="QueryMenu" Grid.Row="1" ColumnSpacing="16" VerticalAlignment="Top" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="PopularGuns" Style="{StaticResource TileButtonStyle}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE734;" FontSize="26" HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="热门" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Click="ChooseWeapon" Style="{StaticResource TileButtonStyle}">
                <StackPanel Spacing="10">
                    <FontIcon Glyph="&#xE721;" FontSize="26" HorizontalAlignment="Left"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="按枪械查询" Style="{StaticResource SubtitleTextBlockStyle}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 列表 -->
        <!-- 面板外观直接设在控件上:可见性由代码切换控件本身,外层不另包容器。 -->
        <ListView x:Name="Results" Grid.Row="1" Visibility="Collapsed" IsItemClickEnabled="True"
                  ItemClick="OpenEntry" SelectionMode="None" Padding="0,6"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource TokenCornerCard}">
                <ListView.ItemTemplate><DataTemplate>
                    <Grid Padding="8,14" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding ListTitle}" FontSize="18" TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>

        <!-- 今日密码:大号读数 -->
        <Border x:Name="PasswordDetail" Grid.Row="1" Visibility="Collapsed"
                Style="{StaticResource CardBorderStyle}">
            <TextBlock x:Name="PasswordText" FontSize="96" FontWeight="Bold"
                       FontFamily="Cascadia Mono, Consolas, Segoe UI"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 集市物品 -->
        <Border x:Name="MarketDetail" Grid.Row="1" Visibility="Collapsed"
                Style="{StaticResource CardBorderStyle}" Padding="28">
            <Grid ColumnSpacing="32">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <Grid>
                    <Image x:Name="MarketImage" MaxWidth="320" MaxHeight="320" Stretch="Uniform"/>
                    <TextBlock x:Name="ImageStatus" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="24">
                    <TextBlock x:Name="MarketName" FontSize="28" TextWrapping="Wrap"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <Button Click="Back">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                            <TextBlock Text="返回"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 改枪码详情 -->
        <ScrollViewer x:Name="GunDetail" Grid.Row="1" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorderStyle}" Padding="24,20">
                <StackPanel Spacing="20">
                    <TextBlock x:Name="GunName" FontSize="24" TextWrapping="Wrap"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="GunText" FontSize="16"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <Button Click="CopyCode" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            <TextBlock Text="复制改枪码"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel x:Name="Toolbar" Grid.Row="2" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <Button x:Name="BackButton" Click="Back" ToolTipService.ToolTip="返回" AutomationProperties.Name="返回"><FontIcon Glyph="&#xE72B;"/></Button>
            <Button x:Name="PreviousButton" Click="PreviousPage" ToolTipService.ToolTip="上一页" AutomationProperties.Name="上一页"><FontIcon Glyph="&#xE76B;"/></Button>
            <Button x:Name="NextButton" Click="NextPage" ToolTipService.ToolTip="下一页" AutomationProperties.Name="下一页"><FontIcon Glyph="&#xE76C;"/></Button>
            <Button x:Name="RefreshButton" Click="RefreshTool" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><FontIcon Glyph="&#xE72C;"/></Button>
            <ProgressRing x:Name="Loading" Width="24" Height="24" IsActive="False"/>
        </StackPanel>
        <TextBlock x:Name="ToolStatus" Grid.Row="3" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"/>
    </Grid>
    </Grid>
</Page>
