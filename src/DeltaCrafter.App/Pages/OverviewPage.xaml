<Page
    x:Class="DeltaCrafter.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeltaCrafter.App.Controls"
    xmlns:vm="using:DeltaCrafter.App.ViewModels">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- 星号三列确定性居中(同 PlanPage 注释):不依赖 Stretch+MaxWidth 的对齐退化。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="999*" MaxWidth="{StaticResource TokenContentMaxWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Padding="{StaticResource TokenPagePadding}"
                        Spacing="{StaticResource TokenGapL}">

                <!-- 标题行:页面标题在左,游戏中提示与声音开关在右。 -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:PageHeader Title="总览" Subtitle="监控四个特勤处设施,并手动或按计划执行收取与续造。" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <controls:StatusBadge Text="游戏中" Level="Critical"
                                              AutomationProperties.AutomationId="OverviewGamePlayingLabel"
                                              Visibility="{x:Bind Vm.GamePlayingVisibility, Mode=OneWay}" />
                        <Button Padding="12,6"
                                AutomationProperties.AutomationId="OverviewMuteButton"
                                AutomationProperties.Name="{x:Bind Vm.MuteLabel, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind Vm.MuteHint, Mode=OneWay}"
                                Command="{x:Bind Vm.ToggleMuteCommand}"
                                IsEnabled="{x:Bind Vm.CanToggleMute, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="{x:Bind Vm.MuteGlyph, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Vm.MuteLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 运行状态卡:左侧状态与操作,右侧「下次执行」读数。 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center" Padding="24,20,0,20">
                            <TextBlock Text="运行状态" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind Vm.RunStateTitle, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Vm.RunStateDetail, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Padding="0,20,24,20">
                            <TextBlock Text="下次执行" Style="{StaticResource SecondaryTextStyle}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind Vm.NextRunText, Mode=OneWay}"
                                       Style="{StaticResource ReadoutTextStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>

                        <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowDividerStyle}" />

                        <!-- 主操作在前;辅助操作随后,单步调试仅开发者模式可见。 -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                                    Padding="24,14,24,16"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="0,0,8,8">
                            <Button Style="{StaticResource AccentButtonStyle}" MinWidth="120"
                                    Command="{x:Bind Vm.RunNowCommand}"
                                    IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay, Converter={StaticResource InvertBool}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="开始制造" />
                                </StackPanel>
                            </Button>
                            <Button Content="停止" MinWidth="80"
                                    Command="{x:Bind Vm.StopCommand}"
                                    IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay}" />
                            <AppBarSeparator Padding="4,0" />
                            <Button Content="识别当前任务"
                                    Command="{x:Bind Vm.SyncNowCommand}"
                                    IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay, Converter={StaticResource InvertBool}}"
                                    ToolTipService.ToolTip="上号识别四个设施当前的状态、物品与剩余时间并同步到调度,不领取、不开工。适合首次使用时特勤处已经在制造的情况。" />
                            <Button Content="关闭游戏"
                                    Command="{x:Bind Vm.CloseGameCommand}"
                                    IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay, Converter={StaticResource InvertBool}}"
                                    ToolTipService.ToolTip="关闭本机三角洲行动，Steam 暂缓期间也可使用；任务执行中请先停止。" />
                            <Button Content="单步调试"
                                    Visibility="{x:Bind Vm.DebugVisibility, Mode=OneWay}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="仅启动到大厅" Command="{x:Bind Vm.DebugLobbyCommand}" />
                                        <MenuFlyoutItem Text="进入特勤处" Command="{x:Bind Vm.DebugSpecOpsCommand}" />
                                        <MenuFlyoutItem Text="截图并识别当前画面" Command="{x:Bind Vm.DebugDumpCommand}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="扫描配方目录(补全物品候选)" Command="{x:Bind Vm.DebugScanCatalogCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar IsOpen="{x:Bind Vm.LastRunFailed, Mode=OneWay}"
                         Severity="Error"
                         IsClosable="False"
                         Title="上一轮执行失败"
                         Message="{x:Bind Vm.LastRunSummary, Mode=OneWay}" />

                <!-- OCR 学习进度:整块可点击,详情由页面弹窗显示。 -->
                <Button Style="{StaticResource TileButtonStyle}"
                        Command="{x:Bind Vm.ShowOcrLearningCommand}"
                        AutomationProperties.Name="OCR 学习进度">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A7;" FontSize="24"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="OCR 学习" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Vm.OcrLearningSummary, Mode=OneWay}"
                                       Style="{StaticResource SecondaryTextStyle}" />
                            <ProgressBar Minimum="0" Maximum="1"
                                         Value="{x:Bind Vm.OcrLearningProgress, Mode=OneWay}"
                                         Visibility="{x:Bind Vm.OcrLearningProgressVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="16"
                                  VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <TextBlock Text="特勤处设施" Style="{StaticResource GroupHeaderTextStyle}" Margin="1,4,0,-8" />
                <!-- 四设施固定 2×2,与游戏内特勤处排布一致;宽度不足时单列,不会出现 3+1 的残行。 -->
                <ItemsRepeater ItemsSource="{x:Bind Vm.Facilities}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="300" MinItemHeight="{StaticResource TokenFacilityCardHeight}"
                                           MaximumRowsOrColumns="2" ItemsStretch="Fill"
                                           MinColumnSpacing="16" MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FacilityCardModel">
                            <controls:FacilityCard Model="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 最近日志摘要 -->
                <TextBlock Text="最近动态" Style="{StaticResource GroupHeaderTextStyle}" Margin="1,4,0,-8" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Vm.RecentLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource SecondaryTextStyle}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
