<Page
    x:Class="DeltaCrafter.App.Pages.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeltaCrafter.App.Controls"
    xmlns:vm="using:DeltaCrafter.App.ViewModels">

    <!-- 星号三列确定性居中(同 PlanPage 注释):不依赖 Stretch+MaxWidth 的对齐退化。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="999*" MaxWidth="{StaticResource TokenWideMaxWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
    <Grid Grid.Column="1" Padding="{StaticResource TokenPagePadding}"
          RowSpacing="{StaticResource TokenGapL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="运行日志"
                             Subtitle="实时运行记录;失败时的截图与识别文本会保存到诊断文件夹。" />

        <!-- 控制台面板:顶部工具条 + 等宽日志流 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,10,12,10" ColumnSpacing="12"
                      Background="{ThemeResource DeltaAccentSubtleBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="等级" VerticalAlignment="Center"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox SelectedIndex="{x:Bind Vm.LevelFilterIndex, Mode=TwoWay}" MinWidth="130">
                            <ComboBoxItem Content="全部" />
                            <ComboBoxItem Content="信息及以上" />
                            <ComboBoxItem Content="警告及以上" />
                            <ComboBoxItem Content="仅错误" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button Command="{x:Bind Vm.OpenLogsFolderCommand}"
                                Style="{StaticResource DeltaSubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="日志文件夹" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind Vm.OpenShotsFolderCommand}"
                                Style="{StaticResource DeltaSubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE722;" FontSize="14" />
                                <TextBlock Text="截图文件夹" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind Vm.ClearViewCommand}"
                                Style="{StaticResource DeltaSubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE894;" FontSize="14" />
                                <TextBlock Text="清空视图" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 虚拟化日志列表 -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Rows}"
                          SelectionMode="None"
                          Padding="0,6,0,6"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="16,3" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogRow">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind TimeText}"
                                           Style="{StaticResource MonoTextStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind LevelText}"
                                           Style="{StaticResource MonoTextStyle}" FontWeight="SemiBold"
                                           Foreground="{x:Bind Level, Converter={StaticResource LogLevelBrush}}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Message}"
                                           Style="{StaticResource MonoTextStyle}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Page>
