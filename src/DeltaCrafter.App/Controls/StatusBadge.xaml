<UserControl
    x:Class="DeltaCrafter.App.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 战术标签:小圆角底 + 状态色圆点。底色与圆点按 Level 走 VisualState 切换,
         颜色全部取系统语义 ThemeResource,深浅色主题实时生效。 -->
    <Border x:Name="Root"
            CornerRadius="{StaticResource TokenCornerBadge}"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DeltaPanelStrokeBrush}"
            BorderThickness="1"
            Padding="8,2,10,3"
            VerticalAlignment="Center">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LevelStates">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="Root.Background"
                                Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource DeltaAccentSubtleBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource DeltaAccentBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="Root.Background"
                                Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="Root.Background"
                                Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center"
                     Fill="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </Border>
</UserControl>
