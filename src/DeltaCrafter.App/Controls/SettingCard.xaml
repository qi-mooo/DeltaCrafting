<UserControl
    x:Class="DeltaCrafter.App.Controls.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 设置页行比例(略紧凑):最小高度 60,图标 20,标题用正文字号。 -->
    <Border Style="{StaticResource CardBorderStyle}" Padding="16,10" MinHeight="60">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0"
                      Glyph="{x:Bind Glyph, Mode=OneWay}"
                      FontSize="20"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind GlyphVisibility(Glyph), Mode=OneWay}" />

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Header, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{x:Bind DescriptionVisibility(Description), Mode=OneWay}" />
            </StackPanel>

            <ContentPresenter Grid.Column="2"
                              Content="{x:Bind Slot, Mode=OneWay}"
                              VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
