<Window
    x:Class="DeltaCrafter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeltaCrafter.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 沉浸式标题栏:整行为拖拽区(SetTitleBar),含应用图标、标题与运行状态。
             右侧留出系统最小化/最大化/关闭按钮的宽度。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource DeltaChromeBrush}"
              Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="20" Height="20" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}">
                    <Run Text="三角洲特勤助手" />
                    <Run Text="{x:Bind VersionText, Mode=OneTime}"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                         FontWeight="Normal" />
                </TextBlock>
                <controls:StatusBadge Text="{x:Bind Shell.StatusText, Mode=OneWay}"
                                      Level="{x:Bind Shell.StatusLevel, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                   Fill="{ThemeResource DeltaPanelStrokeBrush}" />

        <!-- 顶部标签导航,把横向空间全部留给内容。
             内置 Settings 项文案跟随系统语言(英文系统显示「Settings」),
             故禁用内置项,右侧放自定义中文「设置」项保证文案恒为中文。 -->
        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="总览" Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="制造计划" Tag="plan">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="运行日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="工具" Tag="tools">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
